# Copy to .env (gitignored) and fill in. Read by the dev container's demo autostart and by `just demo-pi`.
# Keys go here or in your environment (Codespaces: secrets of the same names), never in a committed file.

# The model: any OpenAI-compatible /v1 endpoint. With none of these set, the demo replays its recorded runs, or,
# if demo_pi/workshop-key.json exists, waits for the workshop code on the page (demo_pi/README.md).
# DEMO_BASE_URL=https://api.openai.com/v1
# DEMO_API_KEY=sk-...
# DEMO_MODEL=gpt-6-luna
# DEMO_MAX_TOKENS=800
# gpt-6-luna and other reasoning models get reasoning_effort "none" by themselves (demo_pi/README.md); override:
# DEMO_REASONING_OFF=none

# Start unlocked with the workshop code instead of typing it on the page
# DEMO_UNLOCK_CODE=k7mp-ra3x

# Sessions at once, across everyone using this server (demo_pi/README.md)
# DEMO_CONCURRENCY=8

# The dev container starts the demo at every container start; 0 turns that off. DEMO_PORT moves it from 8771.
# QCOR_AUTOSTART=1
# DEMO_PORT=8771

# Replay the recorded runs even when the model answers
# DEMO_REPLAY=1
